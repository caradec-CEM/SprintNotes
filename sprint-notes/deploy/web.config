<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse-proxy for Sprint Notes (staging).
  Place this web.config at the root of the IIS site/application that fronts
  Sprint Notes. It forwards every request to the local Vite dev server
  (127.0.0.1:5173) that runs as the "SprintNotes" Windows service.

  Requires, installed once at the server level:
    - URL Rewrite module
    - Application Request Routing (ARR)  → then IIS Manager ▸ server node ▸
      "Application Request Routing Cache" ▸ Server Proxy Settings ▸ tick "Enable proxy"
    - (optional, for Vite HMR) the "WebSocket Protocol" Windows feature
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SprintNotes-ReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5173/{R:1}" />
          <serverVariables>
            <!-- keep the original host/scheme so links resolve correctly -->
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="{MapScheme:{HTTPS}}" />
          </serverVariables>
        </rule>
      </rules>
      <rewriteMaps>
        <rewriteMap name="MapScheme">
          <add key="on" value="https" />
          <add key="off" value="http" />
        </rewriteMap>
      </rewriteMaps>
    </rewrite>
    <!-- ARR needs to forward WebSocket upgrades for Vite HMR; harmless if HMR is off -->
    <webSocket enabled="true" />
  </system.webServer>
</configuration>
